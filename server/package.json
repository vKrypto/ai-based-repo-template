{
  "name": "@barebrilliant/server",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "lint": "eslint src",
    "types": "tsc --noEmit",
    "db:init": "tsx src/shared/db/init.ts",
    "db:migrate": "tsx src/shared/db/migrate.ts",
    "db:populate": "tsx src/shared/db/populate.ts",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "ingest:wedding-rings": "tsx src/infra/ingestion/ingestWeddingRings.ts",
    "seed:demo-categories": "tsx src/infra/ingestion/seedDemoCategories.ts",
    "seed:hover-media": "tsx src/infra/ingestion/seedHoverMedia.ts"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "node-pg-migrate": "^7.6.1",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "eslint": "^9.14.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
